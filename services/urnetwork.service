
[Unit]
Description=URnetwork Public Provider
Wants=network-online.target proxyhub.service
After=network-online.target proxyhub.service

[Service]
Type=simple

WorkingDirectory=/root/urnetwork
EnvironmentFile=/root/urnetwork/.env

# Menunggu ProxyHub hanya jika PROXY_HUB_URL diatur.
# Maksimal 20 percobaan, bukan menunggu selamanya.
ExecStartPre=/bin/bash -c 'if [ -z "$${PROXY_HUB_URL:-}" ]; then exit 0; fi; for i in {1..20}; do curl -fsS --max-time 3 "$${PROXY_HUB_URL}/health" >/dev/null && exit 0; echo "Waiting for ProxyHub..."; sleep 2; done; echo "ProxyHub unavailable" >&2; exit 1'

TimeoutStartSec=120

# Jalankan command provide, bukan hanya binary.
ExecStart=/root/urnetwork/urnetwork provide --stats_interval=300 --event_log=off

Restart=always
RestartSec=15

# Opsional: aktifkan hanya jika perlu restart berkala.
# RuntimeMaxSec=6h
# RuntimeRandomizedExtraSec=10m

LimitNOFILE=65535

KillSignal=SIGINT
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
